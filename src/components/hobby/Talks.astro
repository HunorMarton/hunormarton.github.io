---

<section>
  <h1>Talks</h1>
  <div class="talks-list">
    {
      events.map((event) => (
        <div class="mention">
          <h3>{event.event}</h3>
          <ul>
            {event.talks.map((talk) => (
              <li>
                <div>
                  {talk.date} - {talk.title}
                </div>
                <div>
                  {talk.links?.map((link) => (
                    <a href={link.link} target="_blank" rel="noopener">
                      {link.site}
                    </a>
                  ))}
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  @media (min-width: 1024px) {
    .talks-list {
      columns: 2;
    }
  }

  h3 {
    margin-top: 0;
  }

  li {
    margin-bottom: 20px;
  }

  li > div {
    line-height: 1.5;
  }

  a {
    display: inline-block;

    padding-right: 10px;
  }
</style>
